{
  "compilerOptions": {
    "target": "ES2020",          // Output modern JS
    "module": "commonjs",        // Change to "esnext" if using ESM
    "rootDir": ".",            // Your TS source files
    "outDir": "./dist",            // Where compiled JS will go
    "strict": true,              // Enable strict type-checking
    "esModuleInterop": true,     // Makes import/export easier
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true         // Skip type-checking node_modules
  },
  "include": ["."],            // Compile all files inside src/
  "exclude": ["node_modules", "dist"]    // Don't compile dependencies
}
